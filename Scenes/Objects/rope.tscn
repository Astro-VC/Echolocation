[sub_resource type="GDScript" id="GDScript_ig1xv"]
script/source = "extends TileMapLayer

@export var co : ColorRect
@export var la : Label

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	Global.tape_taken.connect(move.bind())

func move() -> void:
	if Resources.seals[0] == true:
		return
	
	if Resources.seals[1] == true:
		return
	
	if Resources.seals[2] == true:
		return
	
	if Resources.seals[3] == true:
		return
	

	position = Vector2(-8, -211)



func _on_up_body_entered(body: Node2D) -> void:
	if body.name == \"Player\":
		get_tree().paused = true
		var tween : Tween = get_tree().create_tween().bind_node(self)
		tween.TWEEN_PROCESS_PHYSICS
		tween.tween_property(co, \"color\", Color(\"cbcbcb\"), 5)
		tween.tween_property(la, \"modulate\", Color(\"131313\"), 5)
		
		await get_tree().create_timer(25).timeout
		tween.tween_property(co, \"color\", Color(\"ffffff00\"), 5)
		tween.tween_property(la, \"modulate\", Color(\"ffffff00\"), 5)
		
		await get_tree().create_timer(35).timeout
		get_tree().paused = false
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
		get_tree().change_scene_to_file(\"res://Scenes/UI/menu.tscn\")
"

