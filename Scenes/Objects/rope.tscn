script/source = "extends Label


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	text = \"Deaths: \" + str(Resources.deaths)
"

[sub_resource type="GDScript" id="GDScript_s84mu"]
script/source = "extends Label


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	text = \"Collectibles: \" + str(Resources.projectiles[1])
"

[sub_resource type="GDScript" id="GDScript_aui0j"]
script/source = "extends Label

var secs : float
@export var tm : Timer

var min : int

func _process(delta: float) -> void:
	text = \"Time: \" + str(min) + \":\" + str(secs)
	
	secs += int(delta)
	
	ount()

func ount() -> void:
	if secs >= 60:
		min += 1
		secs = 0
"

