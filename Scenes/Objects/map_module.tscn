[sub_resource type="GDScript" id="GDScript_2xkve"]
script/source = "extends Control

@export var map_id : int
@export var show_icon : bool
@export var id : int

@export_category(\"Paths\")
@export var left : bool
@export var right : bool
@export var up : bool
@export var down : bool

func _ready() -> void:
	$Background/Life.text = str(map_id - 10)
	$Background/Background2/Life.text = str(map_id - 10)
	
	if left:
		$Outline/l.show()
	
	if right:
		$Outline/r.show()
	
	if up:
		$Outline/u.show()
	
	if down:
		$Outline/d.show()
	
	
	if show_icon:
		$Outline/Note.show()
		$Outline/Outline2/Note2.show()


func _process(delta: float) -> void:
	if map_id == Resources.map_coord:
		$Background.show()
		$Outline.show()
		return
	$Background.hide()
	
	
	if show_icon:
		if Resources.seals[id] == false:
			$Outline/Outline2/Note2.hide()
			$Outline/Note.hide()
"

