[sub_resource type="GDScript" id="GDScript_h04m2"]
script/source = "extends Control

@export var quit : bool = false

var cycle : bool

func _unhandled_input(event: InputEvent) -> void:
	
	if Resources.seals[0] == false:
		if Resources.seals[1] == false:
			if Resources.seals[2] == false:
				if Resources.seals[3] == false:
					return
	
	if Input.is_action_just_pressed(\"esc\") and !cycle:
		get_parent().get_tree().paused = true
		$CanvasLayer/Control.show()
		cycle = true
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
		return
	
	if Input.is_action_just_pressed(\"esc\") and cycle:
		get_parent().get_tree().paused = false
		$CanvasLayer/Control.hide()
		Input.mouse_mode = Input.MOUSE_MODE_HIDDEN
		cycle = false
		return
"

