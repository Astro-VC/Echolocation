[sub_resource type="GDScript" id="GDScript_ja067"]
script/source = "extends Camera2D

var shake : float = 0.5
var rng := RandomNumberGenerator.new()
var force : Vector2

func _process(delta: float) -> void:
	camera_shake(shake, 5, delta)
	
	if shake > 0:
		shake = 0.5

func camera_shake(force : float, time : float, delta : float) -> void:
	shake = lerpf(force, 0, time * delta)
	offset = Vector2(rng.randf_range(-force, force), rng.randf_range(-force, force))
"

